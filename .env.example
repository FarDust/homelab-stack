# productivity/browser-lab
export BROWSER_LAB_NEKO_ADMIN_PASSWORD=$(cat secrets/unassigned/browser_lab_neko_admin_password | tr -d '\n')  # required secret-file: Neko admin password (Generate: openssl rand -hex 16)
