# Generated from config/env-contract.yaml by scripts/env_contract.py generate-example; edit the contract, not this file.
# Copy to .env and replace placeholders. `.env` is a shell script sourced from the compose root: literals are
# `export NAME=value`, secrets are read from the secrets directory at source time, computed values run a command.

# referenced by other values
export LOCAL_DOMAIN=local.yourdomain.com  # required literal: Subdomain for local services (configure in Cloudflare)

# admin/dashboards
export MONGODB_URL=mongodb://root:your_mongo_password@mongo:27017/  # required literal: Full MongoDB connection URL

# apps/japan-trip-api
export JT_JWKS_VERSION=1  # required literal: Version suffix of the Swarm config holding the identity realm's public JWKS; bump when the realm rotates keys.
export JT_KEYCLOAK_AUDIENCE=japan-trip  # required literal: Audience claim the shared trip API requires in access tokens.
export JT_POSTGREST_IMAGE=your_postgrest_image_reference  # required literal: PostgREST image (tag and digest) serving the shared trip API.

# apps/japan-trip-mcp
export JT_MCP_FEATURES=actuals  # optional literal: Optional MCP tool groups (comma list of actuals, location); enable a group only after its database migration is deployed.
export JT_MCP_IMAGE=your_trip_mcp_image_reference  # required literal: MCP server image of the shared trip (tag and digest), published by the application's release-mcp workflow.
export JT_MCP_SECRET_VERSION=1  # optional literal: Version suffix of the Swarm secret jt_mcp_client_secret-<version> holding the token-exchange client secret; bump when the secret changes.

# apps/japan-trip-realtime
export JT_CENTRIFUGO_CONFIG_VERSION=1  # required literal: Version suffix of the Swarm secret jt_centrifugo_config-<version> holding the rendered Centrifugo configuration; bump with every change.
export JT_CENTRIFUGO_IMAGE=your_centrifugo_image_reference  # required literal: Centrifugo image (tag and digest) pushing realtime events of the shared trip.

# apps/supabase
export CONFIG_VERSION=1  # optional literal: config version setting shared across stacks.
export GOOGLE_PROJECT_ID=your_google_project_id  # required literal: google project id setting for apps/supabase.
