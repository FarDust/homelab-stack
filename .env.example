export LANGFUSE_INIT_PROJECT_ID=your_langfuse_project_id  # optional literal: Initial project UUID (Generate: uuidgen)
export LANGFUSE_INIT_PROJECT_NAME=default  # optional literal: Initial project name
export LANGFUSE_INIT_USER_NAME=admin  # optional literal: Initial Langfuse admin user name
export LANGFUSE_INIT_USER_PASSWORD=$(cat secrets/langfuse/init_user_password | tr -d '\n')  # required secret-file: Initial Langfuse admin password
export LANGFUSE_MINIO_ACCESS_KEY=$(cat secrets/minio/minio_access_key | tr -d '\n')  # required secret-file: MinIO/S3 access key for Langfuse blob storage
export LANGFUSE_MINIO_SECRET_KEY=$(cat secrets/minio/minio_secret_key | tr -d '\n')  # required secret-file: MinIO/S3 secret key for Langfuse blob storage
export LANGFUSE_NEXTAUTH_SECRET=$(cat secrets/langfuse/nextauth_secret | tr -d '\n')  # required secret-file: NextAuth.js secret (Generate: openssl rand -base64 32)
export LANGFUSE_S3_BATCH_EXPORT_BUCKET=langfuse-exports  # optional literal: S3 bucket for Langfuse batch exports
export LANGFUSE_S3_BATCH_EXPORT_ENABLED=true  # optional literal: Enable S3 batch export in Langfuse
export LANGFUSE_S3_BATCH_EXPORT_FORCE_PATH_STYLE=true  # optional literal: Use path-style S3 URLs (required for MinIO)
export LANGFUSE_S3_BATCH_EXPORT_PREFIX=batch/  # optional literal: S3 key prefix for Langfuse batch exports
export LANGFUSE_S3_BATCH_EXPORT_REGION=us-east-1  # optional literal: S3 region for batch exports
export LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse-events  # optional literal: S3 bucket for Langfuse event uploads
export LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true  # optional literal: Use path-style S3 URLs for event uploads
export LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/  # optional literal: S3 key prefix for event uploads
export LANGFUSE_S3_EVENT_UPLOAD_REGION=us-east-1  # optional literal: S3 region for event uploads
export LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse-media  # optional literal: S3 bucket for Langfuse media uploads
export LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true  # optional literal: Use path-style S3 URLs for media uploads
export LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/  # optional literal: S3 key prefix for media uploads
export LANGFUSE_S3_MEDIA_UPLOAD_REGION=us-east-1  # optional literal: S3 region for media uploads
export LANGFUSE_SALT=$(cat secrets/langfuse/salt | tr -d '\n')  # required secret-file: Password hash salt (Generate: openssl rand -base64 32)
export LANGFUSE_USE_AZURE_BLOB=false  # optional literal: Use Azure Blob Storage instead of S3
export LANGFUSE_WEB_REPLICAS=2  # optional literal: langfuse web replicas setting for llms/monitoring.
export LANGFUSE_WORKER_REPLICAS=3  # optional literal: langfuse worker replicas setting for llms/monitoring.
export SMTP_CONNECTION_URL=smtp://apikey:your_sendgrid_key@smtp.sendgrid.net:587  # optional literal: SMTP connection URL for Metaflow notifications
export TELEMETRY_ENABLED=false  # optional literal: Disable telemetry reporting in Open WebUI

# llms/speech
export STT_REPLICAS=0  # optional literal: stt replicas setting for llms/speech.

# llms/speech-cpu
export STT_CPU_REPLICAS=0  # optional literal: stt cpu replicas setting for llms/speech-cpu.

# llms/speech-gpu
export STT_GPU_REPLICAS=1  # optional literal: stt gpu replicas setting for llms/speech-gpu.

# main/bridges
export K3S_SUPAVISOR_PORT=5433  # required literal: Published host port for the K3S Supavisor pooler
export K8S_DB_PASSWORD=$(cat secrets/k8s/db_password | tr -d '\n')  # required secret-file: Password for the K8S/K3S database user (Generate: openssl rand -hex 32)
export NETDATA_CHILD_CONFIG_INTERVAL=5  # optional literal: Netdata child configuration collection interval (seconds)
export NETDATA_CLAIM_ROOMS=your_netdata_room_id  # required literal: Room ID from NetData Cloud
export NETDATA_PARENT_HOST=netdata-parent  # required literal: Hostname or service name of the Netdata parent node
export NETDATA_STREAM_PORT=19999  # required literal: Port for Netdata agent-to-parent streaming
export NETDATA_TOKEN=your_netdata_token  # required literal: Generated from NetData Cloud (https://app.netdata.cloud/)
export RESTART_DELAY_STANDARD=5s  # required literal: Delay between restart attempts for standard services
export RESTART_MAX_ATTEMPTS=3  # required literal: Maximum number of restart attempts before giving up
export RESTART_WINDOW_STANDARD=120s  # required literal: Time window to evaluate restart policy for standard services
export ROLLBACK_MONITOR_STANDARD=30s  # required literal: Rollback health-check monitoring window for standard services
export SUPABASE_JWT_SECRET=$(cat secrets/supabase/self_hosted/jwt_secret | tr -d '\n')  # required secret-file: JWT secret for Supabase auth (Generate: openssl rand -base64 40)
export SUPAVISOR_K3S_DB_PASSWORD_ENCODED=your_url_encoded_supavisor_k3s_password  # required computed: URL-encoded password for supavisor_k3s Postgres role
export SUPAVISOR_K3S_SECRET_KEY_BASE=$(cat secrets/supavisor_k3s/secret_key_base | tr -d '\n')  # required secret-file: Generate: openssl rand -base64 64
export SUPAVISOR_K3S_VAULT_ENC_KEY=$(cat secrets/supavisor_k3s/vault_enc_key | tr -d '\n')  # required secret-file: Generate: openssl rand -base64 32
export TAILSCALE_HOSTNAME=your_tailscale_hostname  # required literal: tailscale hostname setting for main/bridges.
export UPDATE_MONITOR_STANDARD=30s  # required literal: Update health-check monitoring window for standard services

# main/feature-flags
export FLAGS_DATABASE_SSL=false  # optional literal: Unleash DATABASE_SSL setting for the connection to the shared PostgreSQL over the internal overlay.
export FLAGS_FRONTEND_HOSTNAME=app.example.com  # required literal: Host of the application that evaluates flags same-origin under /flags/api/frontend.
export FLAGS_FRONTEND_TOKEN_HEADER=$(cat secrets/feature-flags/frontend_token | tr -d '\n')  # required secret-file: Unleash frontend API token (a public-by-design client token) that Traefik adds on the frontend route; created in the admin API after the first start, rotated there.
export FLAGS_UNLEASH_IMAGE=unleashorg/unleash-server:8.3.1@sha256:025cd8b003a70cceb88427ca393c377ca6503a210d95fdee54d21610d51f7ed0  # required literal: Unleash server image as an exact tag plus digest (docs/adr/feature_flags_service_adr.md).

# main/identity
export KEYCLOAK_ADMIN_PASSWORD=$(cat secrets/keycloak/admin_password | tr -d '\n')  # required secret-file: Keycloak bootstrap admin password (Generate: openssl rand -hex 32)
export KEYCLOAK_DB_PASSWORD=$(cat secrets/keycloak/postgres_password | tr -d '\n')  # required secret-file: Password for the Keycloak PostgreSQL user (Generate: openssl rand -hex 32)
export KEYCLOAK_IMAGE="<registry>/<project>/<repository>/keycloak-optimized@sha256:<digest>"  # required literal: keycloak image setting for main/identity.

# main/identity-gateway
export KEYCLOAK_REALM=your_realm_name  # required literal: Name of the main Keycloak realm
export KEYCLOAK_SIGILCORE_REALM=your_sigilcore_realm_name  # required literal: Name of the Sigilcore Keycloak realm
export OAUTH2_PROXY_CLIENT_ID=your_oauth2_proxy_client_id  # required literal: OAuth2 client ID for oauth2-proxy (from your IdP)
export OAUTH2_PROXY_CLIENT_SECRET=$(cat secrets/oauth2-proxy/client_secret | tr -d '\n')  # required secret-file: OAuth2 client secret for oauth2-proxy
export OAUTH2_PROXY_COOKIE_SECRET=$(cat secrets/oauth2-proxy/cookie_secret | tr -d '\n')  # required secret-file: Generate: openssl rand -base64 32
export POMERIUM_CLIENT_ID=your_pomerium_client_id  # required literal: OAuth2 client ID for Pomerium (from your IdP)
export POMERIUM_CLIENT_SECRET=$(cat secrets/pomerium/client_secret | tr -d '\n')  # required secret-file: OAuth2 client secret for Pomerium
export POMERIUM_COOKIE_SECRET=$(cat secrets/pomerium/cookie_secret | tr -d '\n')  # required secret-file: Generate: openssl rand -base64 32
export POMERIUM_SHARED_SECRET=$(cat secrets/pomerium/shared_secret | tr -d '\n')  # required secret-file: Generate: openssl rand -base64 32
export POMERIUM_SIGNING_KEY=$(cat secrets/pomerium/signing_key | tr -d '\n')  # required secret-file: EC P-256 private key in base64 (see Pomerium docs)
export TRAEFIK_VIP=10.10.0.2  # required literal: Virtual IP of the Traefik load balancer (used in extra_hosts for service-to-Traefik resolution)

# main/logging
export ARTIFACTS_GCS_BUCKET=your_shared_artifacts_bucket  # required literal: Shared artifact bucket (loki/cluster/backup prefix holds Loki archives)
export INTERNAL_PORT=5578  # optional literal: Internal TCP entrypoint port (host-internal, e.g. for Postgres TLS proxy)
export LOKI_RETENTION_PERIOD=2160h  # optional literal: Log retention period in Loki (2160h = 90 days, about 26 GiB)
export LOKI_SYNC_CHECK_MIN_AGE=45m  # optional literal: loki sync check min age setting for main/logging.
export LOKI_SYNC_PSI_MAX_AVG60=40  # optional literal: loki sync psi max avg60 setting for main/logging.
export LOKI_SYNC_SCHEDULE_CHECK="0 5 * * *"  # optional literal: loki sync schedule check setting for main/logging.
export LOKI_SYNC_SCHEDULE_GCS="7,37 * * * *"  # optional literal: loki sync schedule gcs setting for main/logging.
export LOKI_SYNC_SCHEDULE_GCS_FULL="45 3 * * *"  # optional literal: loki sync schedule gcs full setting for main/logging.
export LOKI_SYNC_SCHEDULE_PRUNE="30 4 * * *"  # optional literal: loki sync schedule prune setting for main/logging.
export LOKI_SYNC_SCHEDULE_REPLICA="*/5 * * * *"  # optional literal: loki sync schedule replica setting for main/logging.
export LOKI_SYNC_SCHEDULE_REPLICA_FULL="15 3 * * *"  # optional literal: loki sync schedule replica full setting for main/logging.
export REDIS_PASSWORD=$(cat secrets/redis/redis_password | tr -d '\n')  # required secret-file: Redis password (Generate: openssl rand -hex 32)
export TIMEZONE=UTC  # optional literal: Timezone for Open WebUI and related services

# main/maintenance
export COMPOSE_VAULT_PATH=your_compose_vault_path  # required literal: compose vault path setting for main/maintenance.
export EPHEMERAL_REBALANCE_APPLY=false  # optional literal: ephemeral rebalance apply setting for main/maintenance.
export EPHEMERAL_REBALANCE_DOCKER_GID=998  # optional literal: ephemeral rebalance docker gid setting for main/maintenance.
export EPHEMERAL_REBALANCE_IMAGE="<registry>/<project>/<repository>/ephemeral-rebalance@sha256:<digest>"  # required literal: ephemeral rebalance image setting for main/maintenance.
export EPHEMERAL_REBALANCE_PROMETHEUS_URL=http://tasks.prometheus:9090  # optional literal: ephemeral rebalance prometheus url setting for main/maintenance.
export GCS_SYNC_STORAGE_BUCKET=your-gcs-bucket-name  # required literal: Google Cloud Storage bucket name for rclone backups/sync
export INOTIFY_MAX_USER_INSTANCES=8192  # optional literal: Maximum inotify instances per user (sysctl value)
export INOTIFY_RECONCILE_INTERVAL=60  # optional literal: Interval (seconds) for inotify reconciliation loop
export OTEL_INSECURE=false  # optional literal: Set to true to disable TLS for OTEL collector endpoints
export PGSSLMODE=disable  # optional literal: PostgreSQL SSL mode (disable/require/verify-full)
export POSTGRES_DB=your_database_name  # optional literal: Database name for PostgreSQL
export POSTGRES_HOST=postgres  # optional literal: PostgreSQL hostname (service name in Swarm)
export POSTGRES_PORT=5432  # optional literal: PostgreSQL standard port
export POSTGRES_USER=your_username  # optional literal: Username for PostgreSQL database
export RCLONE_CONTROLLER_IMAGE=your_rclone_controller_image  # required literal: rclone controller image setting for main/maintenance.
export RCLONE_REJECT_CHECK_INTERVAL=60  # optional literal: Interval (seconds) between rclone reject-check iterations
export RCLONE_REJECT_COOLDOWN_SECONDS=300  # optional literal: Cooldown (seconds) after a rclone rejection before retrying
export RCLONE_REJECT_ERROR_PATTERN=error  # optional literal: Pattern to detect errors in rclone output
export REBALANCE_COOLDOWN_SECONDS=30  # optional literal: Global cooldown (seconds) between rebalance cycles
export REBALANCE_INTER_SERVICE_DELAY_SECONDS=30  # optional literal: rebalance inter service delay seconds setting for main/maintenance.
export REBALANCE_SERVICE_COOLDOWN_SECONDS=60  # optional literal: Per-service cooldown (seconds) after a rebalance action
export REBALANCE_SKIP_CONSTRAINTS=""  # optional literal: rebalance skip constraints setting for main/maintenance.
export SENTINEL_APPLY=false  # optional literal: sentinel apply setting for main/maintenance.
export SENTINEL_GRACE_SECONDS=600  # optional literal: sentinel grace seconds setting for main/maintenance.
export SENTINEL_IMAGE="<registry>/<project>/<repository>/crash-loop-sentinel@sha256:<digest>"  # required literal: sentinel image setting for main/maintenance.
export SENTINEL_LOG_RATE_WINDOW=15m  # optional literal: sentinel log rate window setting for main/maintenance.
export SENTINEL_POLL_SECONDS=30  # optional literal: sentinel poll seconds setting for main/maintenance.
export SUPABASE_POSTGRES_DB=postgres  # optional literal: Supabase PostgreSQL database name
export SUPABASE_POSTGRES_PORT=5432  # optional literal: Supabase PostgreSQL port

# main/monitoring
export NEXTDNS_API_KEY=your_nextdns_api_key  # required literal: NextDNS API key (https://my.nextdns.io)
export NEXTDNS_PROFILE=your_nextdns_profile_id  # required literal: NextDNS profile ID (the exporter reads it; Grafana receives it as NEXTDNS_PROFILE_ID for alert rules)
export REDIS_HOST=redis  # required literal: Redis host for session storage
export REDIS_PORT=6379  # required literal: Redis port for session storage

# main/mtu
export MTU_COUNT=3  # optional literal: Number of probe packets per target
export MTU_INTERVAL=60s  # optional literal: Interval between MTU probe rounds
export MTU_PAYLOAD_SIZE=1400  # optional literal: ICMP payload size for MTU probe packets
export MTU_TASKS_DNS=8.8.8.8:53  # optional literal: DNS server used in MTU probe DNS tasks
export MTU_TIMEOUT=10s  # optional literal: Timeout per MTU probe packet

# main/security
export CROWSEC_ENROLL_KEY=your_crowdsec_enroll_key  # required literal: CrowdSec enrollment key from https://app.crowdsec.net
export HOST=${HOSTNAME:-homelab-node}  # required literal: Hostname of the current Swarm node (used for CrowdSec enrollment naming)

# main/storage
export CLICKHOUSE_DB=default  # optional literal: ClickHouse default database name
export CLICKHOUSE_PASSWORD=$(cat secrets/clickhouse/clickhouse_password | tr -d '\n')  # required secret-file: ClickHouse default user password (Generate: openssl rand -hex 32)
export CLICKHOUSE_USER=default  # optional literal: ClickHouse default user
export HOMELAB_PRIVATE_DIR=/path/to/private-deployment-repo  # required literal: Checkout of the private deployment repository; each stack reads its cluster-specific files from it (see docs/homelab-private.md).
export INFLUXDB_PASSWORD=your_influxdb_password  # required literal: Password for InfluxDB admin
export INFLUXDB_USERNAME=your_influxdb_username  # required literal: Username for InfluxDB admin
export LANGFUSE_DB_PASSWORD=$(cat secrets/langfuse/db_password | tr -d '\n')  # required secret-file: Password for Langfuse PostgreSQL user (Generate: openssl rand -hex 32)
export MONGODB_ROOT_USERNAME=root  # optional literal: MongoDB root username
export OPENSEARCH_INITIAL_ADMIN_PASSWORD=$(cat secrets/opensearch/opensearch_password | tr -d '\n')  # required secret-file: OpenSearch initial admin password (min 8 chars, must contain upper/lower/digit/special)
export ORG=your_organization_name  # required literal: Used for various services including InfluxDB
export POSTGRES_PASSWORD=$(cat secrets/postgres/postgres_db_password | tr -d '\n')  # required secret-file: Password for PostgreSQL superuser (Generate: openssl rand -hex 32)
export RESTART_WINDOW_COMPLEX=300s  # optional literal: Time window for complex/slow-start services (e.g. databases)
export ROLLBACK_MONITOR_CACHE=15s  # required literal: Rollback health-check monitoring window for cache services
export ROLLBACK_MONITOR_COMPLEX=120s  # required literal: Rollback health-check monitoring window for complex services
export SUPABASE_JWT_EXPIRY=3600  # optional literal: JWT expiry in seconds for Supabase auth tokens
export SUPABASE_POSTGRES_PASSWORD=$(cat secrets/supabase/self_hosted/postgres_password | tr -d '\n')  # required secret-file: PostgreSQL superuser password for the Supabase DB container (Generate: openssl rand -hex 32)
export SUPAVISOR_APPS_DB_PASSWORD_ENCODED=your_url_encoded_supavisor_apps_password  # required computed: supavisor apps db password encoded setting for main/storage.
export SUPAVISOR_APPS_SECRET_KEY_BASE=$(cat secrets/supavisor_apps/secret_key_base | tr -d '\n')  # required secret-file: Generate: openssl rand -base64 64
export SUPAVISOR_APPS_VAULT_ENC_KEY=$(cat secrets/supavisor_apps/vault_enc_key | tr -d '\n')  # required secret-file: Generate: openssl rand -base64 32
export UPDATE_MONITOR_CACHE=15s  # required literal: Update health-check monitoring window for cache services
export UPDATE_MONITOR_COMPLEX=120s  # required literal: Update health-check monitoring window for complex services

# main/traefik
export AUTHELIA_DUO_API_HOSTNAME=api-xxxxxxxx.duosecurity.com  # required literal: From Duo Security Admin Panel
export AUTHELIA_PREFIX=auth  # required literal: Subdomain prefix for Authelia
export AUTHELIA_SMTP_FROM=auth@yourdomain.com  # required literal: Email address for Authelia notifications
export DOMAIN_NAME=yourdomain.com  # required literal: Your actual domain name registered with Cloudflare
export GF_POSTGRES_DB=grafana  # optional literal: PostgreSQL database name for Grafana backend storage
export GOOGLE_CLIENT_ID=your_google_client_id  # required literal: Google OAuth Client ID for Grafana auth
export GRAFANA_CONFIG_VERSION=1  # required literal: grafana config version setting for main/traefik.
export GRAFANA_GPU_HISTORY_FILE=./configs/grafana/provisioning/dashboards/gpu_history.example.json  # optional literal: grafana gpu history file setting for main/traefik.
export GRAFANA_LOKI_URL=https://loki.local.yourdomain.com  # required literal: Loki URL used by Grafana datasource and vector/otel forwarder
export MAINTAINER_EMAIL=${MAINTAINER_EMAIL:-admin@example.com}  # required literal: maintainer email setting for main/traefik.
export NVIDIA_GPU_TARGETS_FILE=./configs/prometheus/nvidia_targets.example.yml  # optional literal: nvidia gpu targets file setting for main/traefik.
export PORTAINER_AGENT_SECRET=$(cat secrets/portainer/agent_secret | tr -d '\n')  # required secret-file: Shared secret for Portainer agent authentication (Generate: openssl rand -hex 32)
export PROMETHEUS_RETENTION_SIZE=750GB  # optional literal: Prometheus TSDB retention size (e.g. 750GB)
export REDIRECT_SUBDOMAIN=dashy.local  # required literal: Default redirect after Authelia login
export SMTP_FROM=monitor@yourdomain.com  # required literal: Email address for Grafana alerts
export SMTP_USER=apikey  # required literal: SMTP user for SendGrid (typically 'apikey')
export TRUSTED_IPS=127.0.0.1/32,YOUR_LOCAL_SUBNET_CIDR  # required literal: trusted ips setting for main/traefik.
export USER_TIMEZONE=${USER_TIMEZONE:-UTC}  # optional literal: user timezone setting for main/traefik.

# main/trust-agent
export LITELLM_GATEWAY_HOST_IP=your_litellm_gateway_host_ip  # required literal: Address the Trust Agent resolves litellm.${LOCAL_DOMAIN} to (required, no default)
export LITELLM_MASTER_KEY=your_litellm_master_key  # required literal: litellm master key setting for main/trust-agent.
export OPENBAO_ADDR=https://vault.${LOCAL_DOMAIN}  # required literal: OpenBao API address (used by cluster-utils openbao commands)
export TRUST_AGENT_IMAGE="<registry>/<project>/<repository>/trust-agent:0.4.1@sha256:<digest>"  # required literal: trust agent image setting for main/trust-agent.

# main/uptime
export GATUS_DATABASE_URL=postgres://gatus:your_gatus_password@postgres:5432/gatus  # required literal: PostgreSQL connection string for Gatus status storage
export POSTGRES_INTERNAL_PORT=5432  # optional literal: PostgreSQL internal port (may differ when using Traefik TCP proxy)

# ml/orchestration
export MF_METADATA_DB_HOST=postgres  # required literal: PostgreSQL host for Metaflow metadata service
export MF_METADATA_DB_NAME=metaflow  # optional literal: PostgreSQL database name for Metaflow
