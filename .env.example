export JOURNEY_IMAGE=your_journey_image  # required literal: journey image setting for productivity/static-journey.
export JOURNEY_VERSION=your_journey_version  # required literal: journey version setting for productivity/static-journey.

# retrieval/documents
export MAXTOKENNUM=$(cat secrets/unassigned/maxtokennum | tr -d '\n')  # optional secret-file: Maximum token count for Open WebUI completions
export RAGFLOW_HF_ENDPOINT=https://huggingface.co  # required literal: HuggingFace endpoint for RAGflow model downloads
export RAGFLOW_HTTP_APP_KEY=$(cat secrets/ragflow/http_app_key | tr -d '\n')  # required secret-file: RAGflow HTTP API application key
export RAGFLOW_HTTP_SECRET_KEY=$(cat secrets/ragflow/http_secret_key | tr -d '\n')  # required secret-file: RAGflow HTTP API secret key
export RAGFLOW_LITELLM_API_KEY=$(cat secrets/litellm/post_deploy_keys/ragflow_service_key | tr -d '\n')  # required secret-file: LiteLLM API key for RAGflow LLM calls
export RAGFLOW_MCP_API_KEY=$(cat secrets/unassigned/ragflow_mcp_api_key | tr -d '\n')  # required secret-file: API key for RAGFlow MCP server (self-host mode); generate with: openssl rand -hex 32
export RAGFLOW_MINIO_HOST=minio  # required literal: MinIO host for RAGflow object storage
export RAGFLOW_MINIO_PASSWORD=$(cat secrets/minio/minio_secret_key | tr -d '\n')  # required secret-file: MinIO secret key / password for RAGflow
export RAGFLOW_MINIO_PORT=9000  # required literal: MinIO port for RAGflow
export RAGFLOW_MINIO_USER=$(cat secrets/minio/minio_access_key | tr -d '\n')  # required secret-file: MinIO access key / username for RAGflow
export RAGFLOW_OPENSEARCH_PASSWORD=your_opensearch_password  # required literal: OpenSearch password for RAGflow
export RAGFLOW_OS_HOST=opensearch  # required literal: OpenSearch host for RAGflow
export RAGFLOW_OS_PORT=9200  # required literal: OpenSearch port for RAGflow
export RAGFLOW_OS_USER=admin  # required literal: OpenSearch user for RAGflow
export RAGFLOW_POSTGRES_DBNAME=ragflow  # required literal: PostgreSQL database name for RAGflow
export RAGFLOW_POSTGRES_HOST=postgres  # required literal: PostgreSQL host for RAGflow metadata
export RAGFLOW_POSTGRES_PASSWORD=$(cat secrets/ragflow/db_password | tr -d '\n')  # required secret-file: PostgreSQL password for RAGflow
export RAGFLOW_POSTGRES_PORT=5432  # required literal: PostgreSQL port for RAGflow
export RAGFLOW_POSTGRES_SSLMODE=disable  # required literal: PostgreSQL SSL mode for RAGflow (disable/require/verify-full)
export RAGFLOW_POSTGRES_USER=ragflow  # required literal: PostgreSQL user for RAGflow
export RAGFLOW_REDIS_HOST=redis  # required literal: Redis host for RAGflow task queue
export RAGFLOW_REDIS_PASSWORD=your_redis_password  # required literal: Redis password for RAGflow (use the same value as REDIS_PASSWORD if sharing the instance)
export RAGFLOW_REDIS_PORT=6379  # required literal: Redis port for RAGflow

# retrieval/web
export FIRECRAWL_API_REPLICAS=3  # optional literal: firecrawl api replicas setting for retrieval/web.
export FIRECRAWL_BULL_AUTH_KEY=$(cat secrets/firecrawl/bull_auth_key | tr -d '\n')  # required secret-file: firecrawl bull auth key setting for retrieval/web.
export FIRECRAWL_MODEL_EMBEDDING_NAME=your_firecrawl_model_embedding_name  # required literal: firecrawl model embedding name setting for retrieval/web.
export FIRECRAWL_MODEL_NAME=your_firecrawl_model_name  # required literal: firecrawl model name setting for retrieval/web.
export FIRECRAWL_OPENAI_API_KEY=$(cat secrets/firecrawl/litellm_api_key | tr -d '\n')  # required secret-file: firecrawl openai api key setting for retrieval/web.
export FIRECRAWL_OPENAI_BASE_URL=your_firecrawl_openai_base_url  # required literal: firecrawl openai base url setting for retrieval/web.
export FIRECRAWL_REDIS_URL=redis://redis:6379  # optional literal: firecrawl redis url setting for retrieval/web.
export FIRECRAWL_SEARXNG_ENDPOINT=your_firecrawl_searxng_endpoint  # required literal: firecrawl searxng endpoint setting for retrieval/web.
export FIRECRAWL_WORKER_REPLICAS=5  # optional literal: firecrawl worker replicas setting for retrieval/web.
export LOGGING_LEVEL=""  # optional literal: logging level setting for retrieval/web.
export OLLAMA_BASE_URL=""  # optional literal: ollama base url setting for retrieval/web.
export PLAYWRIGHT_MICROSERVICE_URL=http://playwright:3000  # optional literal: Playwright microservice URL for RAGflow web scraping
export POSTHOG_API_KEY=$(cat secrets/unassigned/posthog_api_key | tr -d '\n')  # optional secret-file: posthog api key setting for retrieval/web.
export POSTHOG_HOST=""  # optional literal: posthog host setting for retrieval/web.
export SEARCHAPI_API_KEY=$(cat secrets/unassigned/searchapi_api_key | tr -d '\n')  # optional secret-file: searchapi api key setting for retrieval/web.
export SEARXNG_CATEGORIES=""  # optional literal: searxng categories setting for retrieval/web.
export SEARXNG_ENGINES=""  # optional literal: searxng engines setting for retrieval/web.
export SELF_HOSTED_WEBHOOK_URL=""  # optional literal: self hosted webhook url setting for retrieval/web.
export SERPER_API_KEY=$(cat secrets/unassigned/serper_api_key | tr -d '\n')  # optional secret-file: serper api key setting for retrieval/web.
export SLACK_WEBHOOK_URL=""  # optional literal: slack webhook url setting for retrieval/web.
export SUPABASE_ANON_TOKEN=$(cat secrets/unassigned/supabase_anon_token | tr -d '\n')  # optional secret-file: supabase anon token setting for retrieval/web.
export SUPABASE_SERVICE_TOKEN=$(cat secrets/unassigned/supabase_service_token | tr -d '\n')  # optional secret-file: supabase service token setting for retrieval/web.
export SUPABASE_URL=""  # optional literal: supabase url setting for retrieval/web.
export TEST_API_KEY=$(cat secrets/unassigned/test_api_key | tr -d '\n')  # optional secret-file: test api key setting for retrieval/web.
export USE_DB_AUTHENTICATION=true  # optional literal: Enable database-backed authentication in Open WebUI

# security/dns
export CIDR_BLOCK=10.10.0.0/24  # optional literal: Example subnet - replace with your private subnet
export GATEWAY=10.10.0.1  # optional literal: Example gateway - first IP in your subnet

# security/network
export HOST_DOCKER_GW=172.17.0.1  # required literal: Docker bridge gateway IP (typically 172.17.0.1) for host-level network access

# security/vendor
export CLOUDFLARE_N8N_TUNNEL_TOKEN=$(cat secrets/cloudflare/n8n_tunnel_token | tr -d '\n')  # required secret-file: Cloudflare Tunnel token for n8n ingress (from Cloudflare Zero Trust dashboard)

# vision/generation
export COMFYUI_DATABASE_URL=postgresql://comfyui:your_comfyui_db_password@postgres:5432/comfyui  # optional literal: ComfyUI PostgreSQL URL
