export LOGFLARE_PUBLIC_ACCESS_TOKEN=$(cat secrets/supabase/self_hosted/logflare_public_access_token | tr -d '\n')  # required secret-file: Logflare public access token for Supabase analytics (Generate: openssl rand -hex 32)
