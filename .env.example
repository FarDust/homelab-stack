export MF_METADATA_DB_PORT=5432  # optional literal: PostgreSQL port for Metaflow
export MF_METADATA_DB_TIMEOUT=60  # optional literal: Database connection timeout (seconds) for Metaflow
export MF_METADATA_DB_USER=metaflow  # required literal: PostgreSQL user for Metaflow
