# Gateway baseline (created by Helm-managed Traefik chart)
K3S_TRAEFIK_GATEWAY_NAMESPACE=kube-system
K3S_TRAEFIK_GATEWAY_NAME=traefik-gateway
K3S_TRAEFIK_GATEWAY_HOSTNAME=gateway-smoke.local.example
K3S_TRAEFIK_GATEWAY_TLS_SECRET_NAME=traefik-gateway-websecure-tls
K3S_TRAEFIK_GATEWAY_CERT_ISSUER=local-selfsigned
K3S_TRAEFIK_GATEWAY_TLS_DNS_NAME=local.example

# Smoke route target
K3S_TRAEFIK_GATEWAY_ROUTE_NAMESPACE=kube-system
K3S_TRAEFIK_GATEWAY_ROUTE_NAME=traefik-gateway-smoke
K3S_TRAEFIK_GATEWAY_SMOKE_NAMESPACE=kube-system
K3S_TRAEFIK_GATEWAY_SMOKE_DEPLOYMENT=traefik-gateway-smoke
K3S_TRAEFIK_GATEWAY_SMOKE_SERVICE=traefik-gateway-smoke
