apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: ${K3S_TRAEFIK_GATEWAY_ROUTE_NAME}
  namespace: ${K3S_TRAEFIK_GATEWAY_ROUTE_NAMESPACE}
spec:
  parentRefs:
    - kind: Gateway
      name: ${K3S_TRAEFIK_GATEWAY_NAME}
      namespace: ${K3S_TRAEFIK_GATEWAY_NAMESPACE}
  hostnames:
    - ${K3S_TRAEFIK_GATEWAY_HOSTNAME}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - kind: Service
          name: ${K3S_TRAEFIK_GATEWAY_SMOKE_SERVICE}
          port: 80
