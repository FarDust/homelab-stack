node-name: "${K3S_PRIMARY_NODE_NAME}"
token: "${K3S_SERVER_TOKEN}"

tls-san:
  - ${K3S_PRIMARY_TLS_SAN_DNS}
  - ${K3S_PRIMARY_TLS_SAN_IP}

node-ip: "${K3S_PRIMARY_NODE_IP}"
advertise-address: "${K3S_PRIMARY_ADVERTISE_ADDRESS}"
flannel-iface: "${K3S_FLANNEL_IFACE}"
write-kubeconfig-mode: "0640"
write-kubeconfig-group: "docker"

datastore-endpoint: "${K3S_DATASTORE_ENDPOINT}"
