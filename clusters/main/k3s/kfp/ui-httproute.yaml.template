apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: ${KFP_UI_ROUTE_NAME}
  namespace: ${KFP_NAMESPACE}
spec:
  parentRefs:
    - kind: Gateway
      name: traefik-gateway
      namespace: kube-system
      sectionName: websecure
  hostnames:
    - ${KFP_UI_HOSTNAME}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - kind: Service
          name: ml-pipeline-ui
          port: 80
