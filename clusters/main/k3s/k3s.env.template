# Copy to clusters/main/k3s/k3s.env and fill real values.

K3S_SERVER_TOKEN="replace-me"
K3S_DATASTORE_ENDPOINT="postgres://user:pass@db-host:5432/db-name?sslmode=require"

K3S_PRIMARY_NODE_NAME="manager-primary"
K3S_PRIMARY_TLS_SAN_DNS="manager-primary.example.internal"
K3S_PRIMARY_TLS_SAN_IP="100.64.0.10"
K3S_PRIMARY_NODE_IP="100.64.0.10"
K3S_PRIMARY_ADVERTISE_ADDRESS="100.64.0.10"

# Flannel dataplane interface for inter-node pod traffic.
K3S_FLANNEL_IFACE="tailscale0"

# Secondary manager names used by `render-configs` when --secondary-node is not passed.
K3S_SECONDARY_NODES="manager-a,manager-b"

# Per-secondary node IP/advertise values (node name normalized to uppercase + underscores).
K3S_NODE_IP_MANAGER_A="100.64.0.11"
K3S_NODE_ADVERTISE_ADDRESS_MANAGER_A="100.64.0.11"
K3S_NODE_IP_MANAGER_B="100.64.0.12"
K3S_NODE_ADVERTISE_ADDRESS_MANAGER_B="100.64.0.12"

# Optional global fallback if you render only one secondary node.
# K3S_NODE_IP="100.64.0.20"
# K3S_NODE_ADVERTISE_ADDRESS="100.64.0.20"
