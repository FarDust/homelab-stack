# Copy to clusters/main/storage/minio-bridge/minio-bridge.env and edit as needed.

# Namespace where both producer workloads and sync job run.
K8S_SYNC_NAMESPACE="ml-validation"

# Shared CephFS claim mounted by producers and sync job.
K8S_SYNC_PVC_NAME="k8s-hot-cephfs"
K8S_SYNC_STORAGE_CLASS="ceph-filesystem-rwx"
K8S_SYNC_PVC_SIZE="20Gi"

# Cron schedule for CephFS -> MinIO sync.
K8S_SYNC_CRON_SCHEDULE="*/10 * * * *"
K8S_SYNC_JOB_NAME="cephfs-minio-sync"
K8S_SYNC_SECRET_NAME="minio-sync-credentials"

# Node placement label for sync egress. Label exactly one node with this key/value.
K8S_SYNC_NODE_SELECTOR_KEY="storage.sync/minio-egress"
K8S_SYNC_NODE_SELECTOR_VALUE="true"

# Source path inside PVC and destination key prefix.
K8S_SYNC_SOURCE_PATH="/data/hot/k8s"
K8S_SYNC_MINIO_BUCKET="k8s-hot"
K8S_SYNC_MINIO_PREFIX="k8s"

# Optional overrides (leave empty to use .env defaults)
# K8S_SYNC_MINIO_ENDPOINT="https://minio-api.example.local"
# K8S_SYNC_MINIO_ACCESS_KEY=""
# K8S_SYNC_MINIO_SECRET_KEY=""
# K8S_SYNC_MINIO_INSECURE="true"
