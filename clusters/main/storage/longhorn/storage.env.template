# Copy to clusters/main/storage/longhorn/storage.env and fill real values.

# Global Longhorn defaults
LONGHORN_DEFAULT_DATA_PATH="/var/lib/kubelet/longhorn"
LONGHORN_DEFAULT_REPLICA_COUNT="2"
LONGHORN_REPLICA_SOFT_ANTI_AFFINITY="false"
LONGHORN_REPLICA_AUTO_BALANCE="disabled"
LONGHORN_STORAGE_OVERPROVISIONING_PERCENTAGE="100"
LONGHORN_STORAGE_MINIMAL_AVAILABLE_PERCENTAGE="25"
LONGHORN_CREATE_DEFAULT_DISK_LABELED_NODES="false"

# Per-node policy (repeat manually per node as needed)
LONGHORN_NODE_NAME="node-a"
LONGHORN_NODE_ALLOW_SCHEDULING="true"
