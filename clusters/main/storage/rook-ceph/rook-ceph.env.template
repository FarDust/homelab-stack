# Copy to clusters/main/storage/rook-ceph/rook-ceph.env and fill real values.

ROOK_NAMESPACE="rook-ceph"
ROOK_RELEASE_NAME="rook-ceph"
ROOK_CLUSTER_RELEASE_NAME="rook-ceph-cluster"
ROOK_CHART_VERSION="1.19.1"

# Ceph cluster sizing (development-friendly defaults)
ROOK_MON_COUNT="1"
ROOK_MGR_COUNT="1"
ROOK_OSD_COUNT="2"
ROOK_OSD_PVC_SIZE="40Gi"
ROOK_OSD_STORAGE_CLASS="longhorn"

# CephFS settings
ROOK_CEPHFS_NAME="ceph-filesystem"
ROOK_CEPHFS_SC_NAME="ceph-filesystem-rwx"
ROOK_CEPH_POOL_REPLICA_SIZE="2"

# Ceph daemon resources
ROOK_MON_CPU_REQUEST="200m"
ROOK_MON_MEM_REQUEST="512Mi"
ROOK_MGR_CPU_REQUEST="200m"
ROOK_MGR_MEM_REQUEST="512Mi"
ROOK_OSD_CPU_REQUEST="200m"
ROOK_OSD_MEM_REQUEST="1Gi"
ROOK_MDS_CPU_REQUEST="250m"
ROOK_MDS_MEM_REQUEST="1Gi"
