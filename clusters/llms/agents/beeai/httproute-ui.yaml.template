apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: ${BEEAI_UI_ROUTE_NAME}
  namespace: ${BEEAI_NAMESPACE}
spec:
  parentRefs:
    - kind: Gateway
      name: traefik-gateway
      namespace: kube-system
      sectionName: websecure
  hostnames:
    - ${BEEAI_UI_HOSTNAME}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - kind: Service
          name: agentstack-ui-svc
          port: 8334
