# Copy to beeai.env (local-only realization).

# K8s placement
BEEAI_NAMESPACE="llms-agents"
BEEAI_RELEASE_NAME="beeai"
BEEAI_SERVICE_ACCOUNT_NAME="beeai-workload"
BEEAI_UI_ROUTE_NAME="beeai-ui"
BEEAI_API_ROUTE_NAME="beeai-api"
BEEAI_UI_HOSTNAME="beeai.${LOCAL_DOMAIN}"
BEEAI_API_HOSTNAME="beeai-api.${LOCAL_DOMAIN}"

# Pin chart/runtime versions (do not use latest)
BEEAI_CHART_VERSION="0.6.1"
BEEAI_IMAGE_TAG="0.6.1"
BEEAI_REGISTRY_VERSION="v0.6.1"

# LLM routing (through LiteLLM)
BEEAI_LLM_MODEL="n8n-chat"
BEEAI_FAST_LLM="n8n-chat"
BEEAI_SMART_LLM="n8n-chat"
BEEAI_STRATEGIC_LLM="n8n-chat"
BEEAI_EMBEDDING_MODEL="text-embedding-3-small"
BEEAI_LITELLM_API_KEY="$(cat secrets/beeai/litellm_api_key | tr -d '\n')"

# BeeAI app secrets (local realization only)
BEEAI_ENCRYPTION_KEY="replace-with-generated-fernet-key"
BEEAI_JWT_SECRET="replace-with-random-secret"
BEEAI_ADMIN_PASSWORD="replace-with-strong-admin-password"

# External OIDC (existing Keycloak)
BEEAI_OIDC_REALM="sigilcore"
BEEAI_OIDC_ISSUER="https://idp.${LOCAL_DOMAIN}/realms/${BEEAI_OIDC_REALM}"
BEEAI_OIDC_PROVIDER_NAME="Keycloak"
BEEAI_OIDC_PROVIDER_ID="oidc"
BEEAI_OIDC_UI_CLIENT_ID="agentstack-ui"
BEEAI_OIDC_SERVER_CLIENT_ID="agentstack-server"
BEEAI_OIDC_UI_CLIENT_SECRET="$(cat secrets/beeai/ui_client_secret | tr -d '\n')"
BEEAI_OIDC_SERVER_CLIENT_SECRET="$(cat secrets/beeai/server_client_secret | tr -d '\n')"

# Shared Postgres prerequisite (no dedicated BeeAI DB container)
# Provision these using existing cluster-utils db workflow.
BEEAI_POSTGRES_HOST="postgres.${LOCAL_DOMAIN}"
BEEAI_POSTGRES_PORT="5578"
BEEAI_POSTGRES_DB="beeai"
BEEAI_POSTGRES_USER="beeai_user"
BEEAI_POSTGRES_PASSWORD="replace-with-generated-db-password"
