<?xml version="1.0"?>
<!--
  Keep ClickHouse self-telemetry off the data disk; as decided in
  docs/adr/hdd_node_io_budget_adr.md. query_log and crash_log stay.
-->
<clickhouse>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <part_log remove="1"/>
    <latency_log remove="1"/>
    <error_log remove="1"/>
    <query_metric_log remove="1"/>
    <query_thread_log remove="1"/>
    <processors_profile_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
</clickhouse>
