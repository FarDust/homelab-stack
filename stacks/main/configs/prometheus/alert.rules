groups:
- name: example
  rules:

  # One-person homelab: only interrupt on core monitoring/control-plane scrape loss.
  - alert: service_down
    expr: up{job=~"prometheus|grafana|traefik|blackbox-exporter"} == 0
    for: 10m
    labels:
      severity: warning
      tier: core
    annotations:
      summary: "Core monitoring target {{ $labels.job }} unavailable"
      description: "{{ $labels.instance }} (job {{ $labels.job }}) has been unreachable for more than 10 minutes. Chronic non-user-facing scrape gaps stay in dashboards instead of paging."

  # One-person homelab: alert on sustained saturation, not ordinary busy-node background load.
  - alert: high_load
    expr: |
      (
        node_load15 / count by (instance, job) (node_cpu_seconds_total{mode="idle"}) > 3
      )
      and on(instance, job)
      (
        1 - avg by (instance, job) (rate(node_cpu_seconds_total{mode="idle"}[15m])) > 0.85
      )
    for: 30m
    labels:
      severity: warning
      tier: maintenance
    annotations:
      summary: "Host {{ $labels.instance }} under sustained saturation"
      description: "{{ $labels.instance }} has load/core > 3 and CPU busy > 85% for 30 minutes. Treat as capacity or runaway-work investigation, not a transient spike."

- name: mtu-mesh
  rules:
  - record: mtu_ping_status
    expr: |
      label_join(
        max by (source_node, source_ip, target_node, target_ip, name, target, job) (
          ping_status{job="mtu-network-exporter",source_node!=""}
            * on (target_ip) group_left(target_node)
              label_replace(
                label_replace(
                  max by (source_ip, source_node) (ping_status{job="mtu-network-exporter",source_node!=""}),
                  "target_ip", "$1", "source_ip", "(.*)"
                ),
                "target_node", "$1", "source_node", "(.*)"
              )
        ),
        "id", "::", "source_node", "target_node"
      )
  - record: mtu_ping_loss_percent
    expr: |
      label_join(
        max by (source_node, source_ip, target_node, target_ip, name, target, job) (
          ping_loss_percent{job="mtu-network-exporter",source_node!=""}
            * on (target_ip) group_left(target_node)
              label_replace(
                label_replace(
                  max by (source_ip, source_node) (ping_status{job="mtu-network-exporter",source_node!=""}),
                  "target_ip", "$1", "source_ip", "(.*)"
                ),
                "target_node", "$1", "source_node", "(.*)"
              )
        ),
        "id", "::", "source_node", "target_node"
      )
  - record: mtu_ping_rtt_seconds_mean
    expr: |
      label_join(
        max by (source_node, source_ip, target_node, target_ip, name, target, job) (
          ping_rtt_seconds{job="mtu-network-exporter",source_node!="",type="mean"}
            * on (target_ip) group_left(target_node)
              label_replace(
                label_replace(
                  max by (source_ip, source_node) (ping_status{job="mtu-network-exporter",source_node!=""}),
                  "target_ip", "$1", "source_ip", "(.*)"
                ),
                "target_node", "$1", "source_node", "(.*)"
              )
        ),
        "id", "::", "source_node", "target_node"
      )
  - record: mtu_ping_rtt_seconds_worst
    expr: |
      label_join(
        max by (source_node, source_ip, target_node, target_ip, name, target, job) (
          ping_rtt_seconds{job="mtu-network-exporter",source_node!="",type="worst"}
            * on (target_ip) group_left(target_node)
              label_replace(
                label_replace(
                  max by (source_ip, source_node) (ping_status{job="mtu-network-exporter",source_node!=""}),
                  "target_ip", "$1", "source_ip", "(.*)"
                ),
                "target_node", "$1", "source_node", "(.*)"
              )
        ),
        "id", "::", "source_node", "target_node"
      )

  - record: mtu_edge_status
    expr: |
      label_replace(
        label_replace(mtu_ping_status{target_node!=""}, "source", "$1", "source_node", "(.*)"),
        "target", "$1", "target_node", "(.*)"
      )
  - record: mtu_edge_rtt_ms
    expr: |
      label_replace(
        label_replace(mtu_ping_rtt_seconds_mean{target_node!=""} * 1000, "source", "$1", "source_node", "(.*)"),
        "target", "$1", "target_node", "(.*)"
      )
  - record: mtu_edge_loss_percent
    expr: |
      label_replace(
        label_replace(mtu_ping_loss_percent{target_node!=""}, "source", "$1", "source_node", "(.*)"),
        "target", "$1", "target_node", "(.*)"
      )
  - record: mtu_edge_thickness
    expr: |
      label_replace(
        label_replace((100 - mtu_ping_loss_percent{target_node!=""}), "source", "$1", "source_node", "(.*)"),
        "target", "$1", "target_node", "(.*)"
      )

  - record: mtu_node_links
    expr: |
      label_replace(
        count by (id) (
          label_replace(mtu_ping_status, "id", "$1", "source_node", "(.*)")
        or
          label_replace(mtu_ping_status, "id", "$1", "target_node", "(.*)")
        ),
        "title", "$1", "id", "(.*)"
      )
  - record: mtu_node_rtt_ms
    expr: |
      label_replace(
        avg by (id) (
          label_replace(mtu_ping_rtt_seconds_mean * 1000, "id", "$1", "source_node", "(.*)")
        or
          label_replace(mtu_ping_rtt_seconds_mean * 1000, "id", "$1", "target_node", "(.*)")
        ),
        "title", "$1", "id", "(.*)"
      )
  - record: mtu_node_loss_percent
    expr: |
      label_replace(
        avg by (id) (
          label_replace(mtu_ping_loss_percent, "id", "$1", "source_node", "(.*)")
        or
          label_replace(mtu_ping_loss_percent, "id", "$1", "target_node", "(.*)")
        ),
        "title", "$1", "id", "(.*)"
      )

- name: docker-health
  rules:
  - alert: DockerHealthTargetDown
    expr: up{job="docker-health"} == 0
    for: 10m
    labels:
      severity: warning
      tier: maintenance
    annotations:
      summary: "docker-health target unavailable on {{ $labels.instance }}"
      description: "Prometheus cannot scrape docker-health target {{ $labels.instance }} for more than 10 minutes. This stays warning-level to avoid flapping pages for a one-person homelab."

  - alert: DockerContainerUnhealthy
    expr: max by (instance, engine_host, com_docker_swarm_service_name, container_name) (docker_container_health_failing_streak{job="docker-health",container_status="running"}) > 0
    for: 10m
    labels:
      severity: warning
      tier: maintenance
    annotations:
      summary: "Container unhealthy on {{ $labels.engine_host }}"
      description: "Container {{ $labels.container_name }} (service {{ $labels.com_docker_swarm_service_name }}) has failing healthchecks for more than 10 minutes (streak={{ $value }})."

- name: host-resources
  rules:
  - alert: HostLowSwapAvailable
    expr: |
      node_memory_SwapTotal_bytes > 0
      and on(instance, job)
      (node_memory_SwapFree_bytes / node_memory_SwapTotal_bytes < 0.25)
    for: 10m
    labels:
      severity: warning
      tier: maintenance
    annotations:
      summary: "Host {{ $labels.instance }} has low swap available"
      description: "{{ $labels.instance }} has less than 25% swap free for more than 10 minutes. Check Netdata, memory-heavy workloads, recent deploys, and swap growth before changing placements or host daemons."

  # A saturated disk makes every job on the node slow; investigate the consumer
  # instead of queueing work behind it. See docs/adr/hdd_node_io_budget_adr.md.
  - alert: HostIoPressureSustained
    expr: rate(node_pressure_io_waiting_seconds_total[15m]) > 0.30
    for: 30m
    labels:
      severity: warning
      tier: maintenance
    annotations:
      summary: "Host {{ $labels.instance }} under sustained I/O pressure"
      description: "Tasks on {{ $labels.instance }} waited on I/O more than 30% of the time for 30 minutes. Name the writer from per-cgroup io.stat and remove the cause; a lock or a lower concurrency is not the fix."

  - alert: HostDiskSaturated
    expr: rate(node_disk_io_time_seconds_total{device=~"sd[a-z]+|vd[a-z]+|nvme[0-9]+n[0-9]+"}[15m]) > 0.90
    for: 30m
    labels:
      severity: warning
      tier: maintenance
    annotations:
      summary: "Disk {{ $labels.device }} on {{ $labels.instance }} saturated"
      description: "{{ $labels.device }} on {{ $labels.instance }} was busy more than 90% of the time for 30 minutes. Attribute the I/O per container and fix the consumer."

- name: monitoring-path
  rules:
  - alert: PrometheusVipPathDivergence
    expr: |
      max_over_time(probe_success{job="blackbox",probe="monitoring_prometheus_vip"}[2m]) == 0
      and on()
      max_over_time(probe_success{job="blackbox",probe="monitoring_prometheus_task"}[2m]) == 1
    for: 1m
    labels:
      severity: warning
    annotations:
      summary: "Prometheus service VIP path is failing while task path is healthy"
      description: "Blackbox probes show VIP/alias path down and task path healthy. This indicates Swarm service-path divergence rather than Prometheus process outage. Check DNS/service VIP resolution and overlay routing."

- name: volcano-node-mapping
  rules:
  - record: volcano_node_uname_info
    expr: node_uname_info{job="node-exporter"}

- name: feature-flags
  rules:
  # Evaluation keeps working from client caches while these fire; see docs/adr/feature_flags_service_adr.md
  - alert: FeatureFlagServiceDown
    expr: sum(up{job="feature-flags"}) == 0 or absent(up{job="feature-flags"})
    for: 3m
    labels:
      severity: critical
      tier: platform
    annotations:
      summary: "Feature-flag service has no healthy replica"
      description: "No Unleash replica answers its metrics endpoint for 3 minutes. Clients evaluate from their last-known-good snapshot; flag changes do not reach them and the admin panel is down. Check main-feature-flags_unleash tasks and the unleash database, then the break-glass runbook in the ADR."

  - alert: FeatureFlagServiceDegraded
    expr: count(up{job="feature-flags"} == 1) < 2
    for: 15m
    labels:
      severity: warning
      tier: platform
    annotations:
      summary: "Feature-flag service runs on fewer than two replicas"
      description: "Only {{ $value }} Unleash replica is healthy for 15 minutes; one more failure takes the admin panel down. Check task placement on the two stable nodes."

- name: postgres-backups
  rules:
  # Stale and Missing cover the active backup services only. authelia-db-backup runs at 0 replicas;
  # as decided in docs/adr/authelia_to_keycloak_forwardauth_adr.md
  - alert: PostgreSQLBackupStatusUnhealthy
    expr: postgres_backup_status_ok == 0
    for: 15m
    labels:
      severity: warning
      tier: maintenance
    annotations:
      summary: "PostgreSQL backup status unhealthy for {{ $labels.service }}"
      description: "Backup status metric for {{ $labels.service }} reports unhealthy reason {{ $labels.reason }} for more than 15 minutes. This is observation-only and does not restart backup services."

  - alert: PostgreSQLBackupMetricsStale
    expr: label_replace((time() - node_textfile_mtime_seconds{job="node-exporter",file=~"/rootfs/var/lib/node_exporter/textfile_collector/postgres_backup_(postgres-backup|supabase-db-backup|keycloak-db-backup)\\.prom"} > 900), "service", "$1", "file", ".*/postgres_backup_(.*)\\.prom")
    for: 10m
    labels:
      severity: warning
      tier: maintenance
    annotations:
      summary: "PostgreSQL backup metrics stale for {{ $labels.service }}"
      description: "Textfile metrics for {{ $labels.service }} have not been refreshed for more than 15 minutes. The backup container, observer loop, status command, or node textfile path may be stuck while old green metrics remain scraped."

  - alert: PostgreSQLBackupMetricsMissing
    expr: absent(postgres_backup_status_ok{service="postgres-backup"}) or absent(postgres_backup_status_ok{service="supabase-db-backup"}) or absent(postgres_backup_status_ok{service="keycloak-db-backup"})
    for: 10m
    labels:
      severity: warning
      tier: maintenance
    annotations:
      summary: "PostgreSQL backup metrics missing for {{ $labels.service }}"
      description: "Prometheus has no postgres_backup_status_ok series for expected backup service {{ $labels.service }}. This detects missing textfiles, stopped observers, stopped backup containers, or scrape coverage gaps."


- name: ingress-control-plane
  rules:
  - alert: IngressControlPlaneProbeDown
    expr: probe_success{job="blackbox",monitor_group="ingress_control_plane"} == 0
    for: 2m
    labels:
      severity: warning
      tier: core
    annotations:
      summary: "Ingress probe {{ $labels.probe }} failed"
      description: "{{ $labels.instance }} for service {{ $labels.service }} failed its blackbox probe for more than 2 minutes. Expected status is {{ $labels.expected_status }}."

  - alert: IngressControlPlaneUnexpectedStatus
    expr: |
      probe_http_status_code{job="blackbox",monitor_group="ingress_control_plane",expected_status="200"} != 200
      or
      probe_http_status_code{job="blackbox",monitor_group="ingress_control_plane",expected_status="401"} != 401
    for: 2m
    labels:
      severity: warning
      tier: core
    annotations:
      summary: "Ingress probe {{ $labels.probe }} returned unexpected HTTP status"
      description: "{{ $labels.instance }} for service {{ $labels.service }} returned HTTP {{ $value }} while expected status is {{ $labels.expected_status }}."

  - alert: IngressControlPlaneProbeSlow
    expr: probe_duration_seconds{job="blackbox",monitor_group="ingress_control_plane"} > 3
    for: 5m
    labels:
      severity: warning
      tier: maintenance
    annotations:
      summary: "Ingress probe {{ $labels.probe }} is slow"
      description: "{{ $labels.instance }} for service {{ $labels.service }} has blackbox duration above 3 seconds for more than 5 minutes."
