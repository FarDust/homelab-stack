authentication:
  client:
    switch: false
    http_app_key: '${RAGFLOW_HTTP_APP_KEY}'
    http_secret_key: '${RAGFLOW_HTTP_SECRET_KEY}'
  site:
    switch: false
permission:
  switch: false
  component: false
  dataset: false

user_default_llm:
  factory: "OpenAI"
  api_key: "${RAGFLOW_LITELLM_API_KEY}"
  base_url: "https://litellm.${LOCAL_DOMAIN}/v1"
  default_models:
    chat_model: "gpt-5-chat-latest"
    embedding_model: "text-embedding-3-small"
    rerank_model: "rerank-english-v3.0"
    asr_model: "whisper-1"
    image2text_model: "gpt-4o"
