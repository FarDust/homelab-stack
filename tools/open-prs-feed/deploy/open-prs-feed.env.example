# open-prs-feed settings. Real repository names and hosts live in the private env file, not here.
# Every repository of these owners (preferred), and/or single repositories.
OPEN_PRS_FEED_OWNERS=["<owner>"]
# OPEN_PRS_FEED_REPOS=["<other-owner>/<repo>"]
# Absolute path of the directory that node-retention reads (NODE_RETENTION_OPEN_PRS_FILE's parent).
OPEN_PRS_FEED_OUTPUT_DIR=/srv/ci-user/ci-fallback
# Optional: write on this SSH host instead of locally (an alias from ~/.ssh/config).
# OPEN_PRS_FEED_SSH_HOST=<build-node>
# Optional overrides.
# OPEN_PRS_FEED_GH_COMMAND=["gh"]
# OPEN_PRS_FEED_SSH_COMMAND=["ssh"]
# OPEN_PRS_FEED_LIMIT=500
# OPEN_PRS_FEED_ALLOW_EMPTY=false
