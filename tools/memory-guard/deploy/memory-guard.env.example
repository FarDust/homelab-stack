# memory-guard settings. Real paths and the alert recipient live in the private env file, not here.
MEMORY_GUARD_STATE_DIR=<state-dir>
# Arguments separated by |; {message} is replaced by the alert text. The command must print "delivered" on success.
MEMORY_GUARD_ALERT_COMMAND=<uv>|run|--script|<agent-bridge-helper>|post|--from|<sender>|--to|<recipient>|--text|{message}
# MEMORY_GUARD_MIN_FREE_VIRTUAL_GB=8
# MEMORY_GUARD_MIN_FREE_RAM_GB=1
# MEMORY_GUARD_SAMPLES=2
# MEMORY_GUARD_ALERT_INTERVAL_MIN=30
# Ollama API base URL for cause attribution (GET /api/ps); unset reports "cause unknown".
# MEMORY_GUARD_OLLAMA_URL=<ollama-base-url>
# MEMORY_GUARD_OLLAMA_TIMEOUT_S=5
# MEMORY_GUARD_GPU_OTHER_GB=4
# WSL page-cache drop under sustained low free virtual memory. Kill switch: false. Never starts a stopped distro.
# MEMORY_GUARD_RECLAIM_ENABLED=true
# MEMORY_GUARD_WSL_DISTRO=Ubuntu
# MEMORY_GUARD_RECLAIM_SAMPLES=2
# MEMORY_GUARD_RECLAIM_MIN_INTERVAL_MIN=10
# MEMORY_GUARD_RECLAIM_MAX_PER_HOUR=6
# MEMORY_GUARD_RECLAIM_TIMEOUT_S=60
# publish-headroom: writes commit headroom to the guest node-exporter textfile collector. Feature flag, off by default.
# MEMORY_GUARD_HEADROOM_PUBLISH_ENABLED=false
# MEMORY_GUARD_HEADROOM_HOST_LABEL=gabriel-pc
# MEMORY_GUARD_HEADROOM_TIMEOUT_S=30
