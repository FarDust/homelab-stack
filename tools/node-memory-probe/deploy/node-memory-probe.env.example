NODE_MEMORY_PROBE_HOST=worker-1
# Container (name or id) whose largest JVM is always probed; jcmd read-only answers come from it.
# The real container name lives in the node private settings file, not in this repository.
NODE_MEMORY_PROBE_JVM_CONTAINERS='["minecraft-server"]'
# Container name -> process label published in the metrics.
NODE_MEMORY_PROBE_ALIASES='{"minecraft-server":"minecraft"}'
# jcmd attaches to the JVM (see the ADR); set false to read the heap from the JVM flags only.
NODE_MEMORY_PROBE_JCMD_ENABLED=true
NODE_MEMORY_PROBE_TOP_SWAP_PROCESSES=5
NODE_MEMORY_PROBE_SNAPSHOT_SWAP_FREE_BELOW_BYTES=3221225472
NODE_MEMORY_PROBE_SNAPSHOT_PSWPOUT_PAGES_PER_SECOND=100
